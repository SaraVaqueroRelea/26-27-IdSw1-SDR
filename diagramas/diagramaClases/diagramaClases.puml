@startuml
title Diagrama de Clases - Actividades Extracurriculares UNEATLÁNTICO (v5.10)

skinparam classAttributeIconSize 0
hide empty methods

enum EstadoParticipacion {
  APTO
  EN_CURSO
  NO_APTO
}

enum TipoSolicitud {
  CONVALIDACION_OPTATIVA
  ACREDITACION_HISTORIAL
}

enum EstadoSolicitud {
  PENDIENTE
  ACEPTADA
  RECHAZADA
}

abstract class Usuario {
  # dni : String
  # nombre : String
  # apellidos : String
  # correoInstitucional : String
}

class Secretario {
  + crearActividad(actividad : Actividad) : void
  + eliminarActividad(actividad : Actividad) : void
  + asignarOrganizador(actividad : Actividad, organizador : Organizador) : void
  + cerrarActividad(actividad : Actividad) : void
  + modificarActividadCerrada(actividad : Actividad) : void
  + resolverSolicitud(solicitud : Solicitud, aceptada : boolean) : void
}

class Organizador {
  + anadirMiembro(actividad : Actividad, alumno : Alumno, rol : RolParticipacion) : Participacion
  + editarMiembro(participacion : Participacion) : void
  + eliminarMiembro(actividad : Actividad, participacion : Participacion) : void
  + asignarRol(participacion : Participacion, rol : RolParticipacion) : void
  + validarRequisitos(participacion : Participacion, apto : boolean) : void
  + exportarExcelMiembros(actividad : Actividad) : File
  + consultarActividadesOtrosCursos(cursoAcademico : String) : List<Actividad>
}

class Alumno {
  - numeroCarnet : String
  + consultarHistorial() : HistorialExtracurricular
  + crearSolicitud(tipo : TipoSolicitud) : Solicitud
}

class HistorialExtracurricular {
  - /creditosAcumulados : double
  - /creditosPorCategoria : Map<Categoria, double>
  - /creditosValidablesPorCategoria : Map<Categoria, double>
  - /creditosCanjeados : double
  - /creditosDisponibles : double
  + calcularCreditosPorCategoria(categoria : Categoria) : double
  + calcularCreditosValidablesPorCategoria(categoria : Categoria) : double
  + calcularCreditosValidables() : double
  + tieneCreditos() : boolean
  + puedeConvalidarOptativa() : boolean
  + filtrarPorCurso(cursoAcademico : String) : List<Participacion>
  + filtrarPorCategoria(categoria : Categoria) : List<Participacion>
  + descontarCreditos(creditos : double) : void
}

class Categoria {
  - nombre : String
  - maxCreditosValidables : double
  + aplicarTope(creditos : double) : double
  + cumpleTopeCategoria(creditos : double) : boolean
}

class Actividad {
  - nombre : String
  - descripcion : String
  - departamento : String
  - cursoAcademico : String
  - cerrada : boolean
  + cerrar() : void
  + esEditablePor(usuario : Usuario) : boolean
}

class RolParticipacion {
  - nombre : String
  - creditos : double
  - descripcionRequisitos : String
}

class Participacion {
  - creditosAsignados : double
  - estado : EstadoParticipacion
  - codigoDiploma : String
  + establecerRol(rol : RolParticipacion) : void
  + validarCumplimiento(apto : boolean) : void
  + emitirDiploma() : String
}

class Solicitud {
  - fecha : Date
  - tipo : TipoSolicitud
  - creditosSolicitados : double
  - estado : EstadoSolicitud
  - observaciones : String
  + validarRequisitos(historial : HistorialExtracurricular) : boolean
  + aceptar() : void
  + rechazar(motivo : String) : void
}

' Herencia
Usuario <|-- Secretario
Usuario <|-- Organizador
Usuario <|-- Alumno

' Asociaciones
Categoria "1" -- "0..*" Actividad : clasifica >
Secretario "1..*" -- "0..*" Actividad : supervisa >
Organizador "1" -- "0..*" Actividad : coordina >

Actividad "1" *-- "1..*" RolParticipacion : define >
Actividad "1" *-- "0..*" Participacion : registra >
RolParticipacion "1" -- "0..*" Participacion : aplica a >

Alumno "1" *-- "1" HistorialExtracurricular : posee >
HistorialExtracurricular "1" o-- "0..*" Participacion : acumula >

Alumno "1" -- "0..*" Solicitud : presenta >
Secretario "0..1" -- "0..*" Solicitud : resuelve >

' Dependencias con enumeraciones
Participacion ..> EstadoParticipacion
Solicitud ..> TipoSolicitud
Solicitud ..> EstadoSolicitud

@enduml
