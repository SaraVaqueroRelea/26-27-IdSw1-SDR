}

object "rolOrador : RolParticipacion" as rolOrador {
  nombre = "Orador"
  creditos = 2.0
  descripcionRequisitos = "Participación en fase de grupos"
}

object "rolActor : RolParticipacion" as rolActor {
  nombre = "Actor"
  creditos = 2.0
  descripcionRequisitos = "Ensayos semanales y obra final"
}

' Participaciones
object "part1 : Participacion" as part1 {
  creditosAsignados = 4.5
  estado = APTO
  codigoDiploma = "DIP-2026-0142"
}

object "part2 : Participacion" as part2 {
  creditosAsignados = 2.0
  estado = APTO
  codigoDiploma = "DIP-2026-0289"
}

object "part3 : Participacion" as part3 {
  creditosAsignados = 2.0
  estado = EN_CURSO
  codigoDiploma = null
}

' Historial y Solicitud
object "hist1 : HistorialExtracurricular" as hist1 {
  creditosAcumulados = 6.5
  creditosPorCategoria = {Deportes: 4.5, Cultura y Debate: 2.0}
  creditosValidablesPorCategoria = {Deportes: 4.0, Cultura y Debate: 2.0}
  creditosCanjeados = 6.0
  creditosDisponibles = 0.0
}

object "sol1 : Solicitud" as sol1 {
  fecha = "2026-06-15"
  tipo = CONVALIDACION_OPTATIVA
  creditosSolicitados = 6.0
  estado = ACEPTADA
  observaciones = "4.0 ECTS Deportes (tope aplicado) + 2.0 ECTS Cultura"
}

' Enlaces entre objetos
catDep -- act1 : clasifica >
catCul -- act2 : clasifica >
catCul -- act3 : clasifica >

sec1 -- act1 : supervisa >
sec1 -- act2 : supervisa >
sec1 -- act3 : supervisa >

org1 -- act1 : coordina >
org1 -- act2 : coordina >
org1 -- act3 : coordina >

act1 *-- rolCapitan : define >
act2 *-- rolOrador : define >
act3 *-- rolActor : define >

act1 *-- part1 : registra >
act2 *-- part2 : registra >
act3 *-- part3 : registra >

rolCapitan -- part1 : aplica a >
rolOrador -- part2 : aplica a >
rolActor -- part3 : aplica a >

alu1 *-- hist1 : posee >
hist1 o-- part1 : acumula >
hist1 o-- part2 : acumula >
hist1 o-- part3 : acumula >

alu1 -- sol1 : presenta >
sec1 -- sol1 : resuelve >

@enduml
